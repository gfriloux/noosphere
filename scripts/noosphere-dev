#!/usr/bin/env bash
# noosphere-dev — lance une instance DankMaterialShell *isolée* qui ne charge QUE le plugin
# noosphere du worktree courant. Sert à tester la version en cours sans toucher au DMS
# quotidien (géré, lui, par le module home-manager).
#
# Isolation : XDG_CONFIG_HOME + XDG_CACHE_HOME dédiés → settings, dossier de plugins et
# qmlcache séparés de l'instance quotidienne. Le plugin pointe en symlink (live) sur le
# src/ du worktree : on édite, on relance, c'est visible (cache isolé → pas de purge).
#
# L'id du manifeste reste "noosphere" : il doit rester aligné avec `pluginId` dans
# src/view/Settings.qml (sinon les réglages sont écrits/lus sous des clés différentes).
# Seul le libellé affiché passe à "Noosphere (dev)" pour distinguer les deux barres.
#
# Astuce dev : lancer d'abord `just mock` dans un autre terminal, puis régler l'endpoint
# GitHub du plugin sur http://127.0.0.1:8385 (aucun réseau requis).
set -euo pipefail

# Racine du dépôt (contient plugin.json + src/). Défaut : répertoire courant.
if [ "$#" -gt 0 ]; then
    src="$1"
    shift
else
    src="$PWD"
fi
src="$(cd "$src" && pwd)"

if [ ! -f "$src/plugin.json" ] || [ ! -d "$src/src" ]; then
    echo "noosphere-dev : '$src' ne contient pas plugin.json + src/ (pointe la racine du dépôt)." >&2
    exit 1
fi
command -v dms >/dev/null || { echo "noosphere-dev : 'dms' introuvable sur le PATH." >&2; exit 1; }
command -v jq  >/dev/null || { echo "noosphere-dev : 'jq' introuvable sur le PATH." >&2; exit 1; }
command -v quickshell >/dev/null || { echo "noosphere-dev : 'quickshell' introuvable (entrer dans le dev shell : nix develop)." >&2; exit 1; }

# DMS shell root, resolved through the installed binary — no store hash pinned.
# Same resolution as scripts/qml-import-paths.
dms_bin="$(readlink -f "$(command -v dms)")"
dms_shell="${dms_bin%/bin/dms}/share/quickshell/dms"
[ -d "$dms_shell" ] || { echo "noosphere-dev : racine du shell DMS introuvable ($dms_shell)." >&2; exit 1; }

root="${XDG_STATE_HOME:-$HOME/.local/state}/noosphere-dev"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/cache"
export XDG_STATE_HOME="$root/state"

plugindir="$XDG_CONFIG_HOME/DankMaterialShell/plugins/Noosphere"
mkdir -p "$plugindir"

# plugin.json dérivé du worktree : seul le libellé change, l'id reste "noosphere".
jq '.name = "Noosphere (dev)"' "$src/plugin.json" >"$plugindir/plugin.json"
# src live : symlink hors-store vers le worktree.
ln -sfn "$src/src" "$plugindir/src"

echo "noosphere-dev : instance DMS isolée"
echo "  source : $src/src (live)"
echo "  config : $XDG_CONFIG_HOME"
echo "  cache  : $XDG_CACHE_HOME"
echo "  → active 'Noosphere (dev)' dans CETTE instance (Settings → Plugins)."
echo "  → règle l'endpoint GitHub du plugin sur http://127.0.0.1:8385 (avec 'just mock')."
echo "  (Ctrl-C pour arrêter l'instance dev.)"

# Launch the UI through `quickshell` directly, not through `dms run`.
#
# Why: since DMS 1.6, `dms run` starts a Go *backend* and refuses a second one for the same
# session ("dms already running for this session; refusing to start a second instance").
# The guard is right — one backend per session — but it made a dev instance impossible to
# start whenever the everyday bar was running, which is always.
#
# The UI itself is an ordinary Quickshell shell, so open it on the DMS shell root with our
# isolated XDG dirs, keeping the plugin directory and the qmlcache separate. The already
# running backend serves both UIs. Accepted consequence: two bars on screen during a test.
exec quickshell -p "$dms_shell" "$@"
