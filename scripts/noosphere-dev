#!/usr/bin/env bash
# noosphere-dev — starts an *isolated* DankMaterialShell instance loading ONLY the noosphere
# plugin from the current worktree. For testing work in progress without disturbing the
# everyday DMS, which the home-manager module owns.
#
# Isolation: dedicated XDG_CONFIG_HOME + XDG_CACHE_HOME → settings, plugin directory and
# qmlcache separate from the everyday instance. The plugin symlinks the worktree's src/
# live: edit, restart, see it — the isolated cache means nothing to purge.
#
# The manifest id stays "noosphere": it must match `pluginId` in src/view/Settings.qml, or
# the settings are written and read under different keys. Only the displayed name becomes
# "Noosphere (dev)", to tell the two bars apart.
#
# Tip: start `just mock` in another terminal first, then point the plugin's GitHub endpoint
# at http://127.0.0.1:8385 — no network needed.
set -euo pipefail

# Repository root (holding plugin.json + src/). Defaults to the current directory.
if [ "$#" -gt 0 ]; then
    src="$1"
    shift
else
    src="$PWD"
fi
src="$(cd "$src" && pwd)"

if [ ! -f "$src/plugin.json" ] || [ ! -d "$src/src" ]; then
    echo "noosphere-dev: '$src' holds no plugin.json + src/ — point at the repository root." >&2
    exit 1
fi
command -v dms >/dev/null || { echo "noosphere-dev: 'dms' not found on PATH." >&2; exit 1; }
command -v jq  >/dev/null || { echo "noosphere-dev: 'jq' not found on PATH." >&2; exit 1; }
command -v quickshell >/dev/null || { echo "noosphere-dev: 'quickshell' not found (enter the dev shell: nix develop)." >&2; exit 1; }

# DMS shell root, resolved through the installed binary — no store hash pinned.
# Same resolution as scripts/qml-import-paths.
dms_bin="$(readlink -f "$(command -v dms)")"
dms_shell="${dms_bin%/bin/dms}/share/quickshell/dms"
[ -d "$dms_shell" ] || { echo "noosphere-dev: DMS shell root not found ($dms_shell)." >&2; exit 1; }

root="${XDG_STATE_HOME:-$HOME/.local/state}/noosphere-dev"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/cache"
export XDG_STATE_HOME="$root/state"

plugindir="$XDG_CONFIG_HOME/DankMaterialShell/plugins/Noosphere"
mkdir -p "$plugindir"

# plugin.json derived from the worktree: only the displayed name changes, the id stays "noosphere".
jq '.name = "Noosphere (dev)"' "$src/plugin.json" >"$plugindir/plugin.json"
# src/ and translations/ live: out-of-store symlinks into the worktree. The table is
# symlinked rather than copied for the same reason as the source — DMS re-reads it when the
# plugin reloads, so an edit to fr.json shows up on the next restart with nothing to copy.
ln -sfn "$src/src" "$plugindir/src"
ln -sfn "$src/translations" "$plugindir/translations"

echo "noosphere-dev: isolated DMS instance"
echo "  source : $src/src (live)"
echo "  i18n   : $src/translations (live)"
echo "  config : $XDG_CONFIG_HOME"
echo "  cache  : $XDG_CACHE_HOME"
echo "  → enable 'Noosphere (dev)' in THIS instance (Settings → Plugins)."
echo "  → point the plugin's GitHub endpoint at http://127.0.0.1:8385 (with 'just mock')."
echo "  (Ctrl-C to stop the dev instance.)"

# Launch the UI through `quickshell` directly, not through `dms run`.
#
# Why: since DMS 1.6, `dms run` starts a Go *backend* and refuses a second one for the same
# session ("dms already running for this session; refusing to start a second instance").
# The guard is right — one backend per session — but it made a dev instance impossible to
# start whenever the everyday bar was running, which is always.
#
# The UI itself is an ordinary Quickshell shell, so open it on the DMS shell root with our
# isolated XDG dirs, keeping the plugin directory and the qmlcache separate. The already
# running backend serves both UIs. Accepted consequence: two bars on screen during a test.
exec quickshell -p "$dms_shell" "$@"
